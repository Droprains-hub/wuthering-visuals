<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/page_top_padding"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/page_bottom_padding">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/config_page_title" android:textColor="?attr/colorOnSurface" android:textSize="30sp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/config_target_card"
            style="@style/Widget.WuWa.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/config_target_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_target_none" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/config_target_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                </LinearLayout>
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" android:contentDescription="@string/select_server" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextAppearance.WuWa.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/quality_preset_section" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WuWa.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/preset_card_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/replace_card_title" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/replace_card_description" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/preset_level_label" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/preset_toggle_group" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" app:selectionRequired="true" app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/preset_low_button" style="@style/Widget.WuWa.PresetSegmentButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/preset_low" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/preset_medium_button" style="@style/Widget.WuWa.PresetSegmentButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/preset_medium" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/preset_high_button" style="@style/Widget.WuWa.PresetSegmentButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/preset_high" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/preset_extreme_button" style="@style/Widget.WuWa.PresetSegmentButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/preset_extreme" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/preset_selection_detail" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/replace_button" style="@style/Widget.WuWa.PrimaryButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="18dp" android:text="@string/replace_quality" app:icon="@drawable/ic_bolt" app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextAppearance.WuWa.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/resolution_experiment_title" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.WuWa.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resolution_sensor_description" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/portrait_launch_button" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="@string/portrait_launch_game" />
                <com.google.android.material.button.MaterialButton android:id="@+id/restore_rotation_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="4dp" android:text="@string/restore_auto_rotation" />
                <TextView android:id="@+id/rotation_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/rotation_status_idle" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
